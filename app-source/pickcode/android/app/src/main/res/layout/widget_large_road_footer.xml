<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/large_road_footer"
    android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical">
    <TextView android:id="@+id/large_road_scope" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#536073" android:maxLines="1" android:includeFontPadding="false" />
    <LinearLayout android:id="@+id/large_refresh" android:layout_width="64dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/large_refresh_icon" android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/widget_refresh_icon" android:importantForAccessibility="no" />
        <TextView android:id="@+id/large_refresh_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:textSize="8sp" android:textColor="#536073" android:maxLines="1" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <TextView android:id="@+id/large_road_previous" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textSize="15sp" android:textColor="#536073" android:includeFontPadding="false" />
    <TextView android:id="@+id/large_road_page_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#536073" android:includeFontPadding="false" />
    <TextView android:id="@+id/large_road_next" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textSize="15sp" android:textColor="#536073" android:includeFontPadding="false" />
</LinearLayout>
