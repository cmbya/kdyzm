<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/receipt_row_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="#536073" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/receipt_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#172233" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/receipt_row_owner_column" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/receipt_row_owner" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#172233" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/receipt_row_platform" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:textSize="10sp" android:textColor="#536073" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <TextView android:id="@+id/large_row_pick" android:layout_width="57dp" android:layout_height="44dp" android:gravity="center"
            android:background="@drawable/widget_pick_background" android:text="确认收到" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:id="@+id/large_row_divider" android:layout_width="match_parent" android:layout_height="1dp" android:background="#EDF0F5" />
</LinearLayout>
