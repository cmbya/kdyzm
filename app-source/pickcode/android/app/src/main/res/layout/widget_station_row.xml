<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/station_option" android:layout_width="match_parent" android:layout_height="44dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
    <TextView android:id="@+id/station_option_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#172233" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <TextView android:id="@+id/station_option_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:textSize="11sp" android:textColor="#536073" android:includeFontPadding="false" />
    <TextView android:id="@+id/station_option_selected" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="end"
        android:textSize="13sp" android:textColor="#0867FF" android:includeFontPadding="false" />
</LinearLayout>
