<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/large_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_large_background">
    <LinearLayout android:id="@+id/large_pickup_zone" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="156" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="3dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/large_pickup_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="待取" android:textColor="#172233" android:textStyle="bold" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/large_pickup_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:textColor="#0867FF" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/large_station" android:layout_width="0dp" android:layout_weight="1" android:layout_height="24dp" android:layout_marginStart="8dp"
                android:gravity="end|center_vertical" android:textColor="#536073" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ListView android:id="@+id/large_pickup_rows" android:layout_width="match_parent" android:layout_height="match_parent"
                android:divider="@null" android:scrollbars="vertical" android:scrollbarStyle="insideOverlay" android:cacheColorHint="#00000000" />
            <ListView android:id="@+id/large_station_options" android:layout_width="match_parent" android:layout_height="match_parent"
                android:divider="@null" android:scrollbars="vertical" android:scrollbarStyle="insideOverlay" android:cacheColorHint="#00000000" android:visibility="gone" />
            <TextView android:id="@+id/large_pickup_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center" android:text="暂无待取快递" android:textSize="14sp" android:textColor="#536073" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" />
        </FrameLayout>
        <LinearLayout android:id="@+id/large_pickup_undo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/large_road_zone" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="94"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="2dp" android:paddingBottom="1dp" android:background="@drawable/widget_road_background">
        <LinearLayout android:id="@+id/large_road_header" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center_vertical">
            <TextView android:id="@+id/large_road_heading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="待收包裹" android:textSize="11sp" android:textStyle="bold" android:textColor="#536073" android:maxLines="1" android:includeFontPadding="false" />
            <TextView android:id="@+id/large_road_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
                android:textSize="9sp" android:textColor="#536073" android:maxLines="1" android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/large_platform_taobao" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="5dp" android:paddingEnd="5dp"
                android:textColor="#536073" android:textSize="10sp" android:maxLines="1" android:includeFontPadding="false" android:background="@drawable/widget_platform_filter" />
            <TextView android:id="@+id/large_platform_jd" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="3dp" android:gravity="center" android:paddingStart="5dp" android:paddingEnd="5dp"
                android:textColor="#536073" android:textSize="10sp" android:maxLines="1" android:includeFontPadding="false" android:background="@drawable/widget_platform_filter" />
            <TextView android:id="@+id/large_platform_pdd" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="3dp" android:gravity="center" android:paddingStart="5dp" android:paddingEnd="5dp"
                android:textColor="#536073" android:textSize="10sp" android:maxLines="1" android:includeFontPadding="false" android:background="@drawable/widget_platform_filter" />
        </LinearLayout>
        <TextView android:id="@+id/large_road_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="9sp" android:textColor="#738BA5" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <LinearLayout android:id="@+id/large_road_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/large_road_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/large_road_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="暂无待收包裹" android:textSize="11sp" android:textColor="#536073" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <include layout="@layout/widget_large_road_footer" />
    </LinearLayout>
</LinearLayout>
