# External HTTPS origin; no trailing path. Configure your HTTPS reverse proxy first.
PUBLIC_BASE_URL=https://parcel.example.com
# Run `openssl rand -hex 32` separately for each value. Never commit .env.
ADMIN_TOKEN=
COOKIE_ENCRYPTION_KEY=
# Same-host reverse proxy default. For a remote proxy, use a private LAN address.
BIND_ADDRESS=127.0.0.1
PORT=8787
